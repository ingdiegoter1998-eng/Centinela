# Normaliza finales de línea: LF en el repo, lo que toque el SO en el working tree.
* text=auto eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.svg text

# Scripts de Windows: cmd.exe falla con LF en bloques entre paréntesis.
*.bat text eol=crlf
*.cmd text eol=crlf

# Scripts de PowerShell con acentos: CRLF para Windows PowerShell 5.1.
*.ps1 text eol=crlf
