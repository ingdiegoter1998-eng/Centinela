# ── Datos e imágenes ────────────────────────────────────────────────────
build/
*.tif
*.tiff
*.JPG
*.jpg
*.jpeg
*.png
!landing/**/*.png
!landing/**/*.svg
!docs/**/*.png
!docs/adelanto/*.jpg
# El banco de imágenes de referencia SÍ va al repo.
# Licencias y atribución obligatoria: data/ATRIBUCIONES.md
!data/**/*.jpg
!data/**/*.png
# Excepción: material de banco comercial con derechos reservados.
data/samples/musa_lote*
# Salidas de `centinela count / eval / characterize`: se escriben junto a la imagen y
# se regeneran con un comando. Las de referencia ya versionadas viven en data/samples/salidas/.
data/**/*_detecciones.csv
data/**/*_overlay.png
data/**/*_debug.png
data/**/*_manifest.yaml
data/**/*_errores.png
data/**/*_estado.csv
data/**/*_estado.png
data/**/*_centros.csv
data/**/*_centros.png
data/**/*_deepforest.csv
data/**/*_comparacion.png
!data/samples/salidas/**
# Fotos aportadas por usuarios sin licencia registrada: se usan en local, no se redistribuyen.
data/samples/usuario/

# HTML de artefactos con imágenes embebidas (generado — se arma desde el .html fuente)
*.build.html

