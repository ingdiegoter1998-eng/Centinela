# Copia este archivo como .env y llénalo. .env nunca se sube al repo.

# Cámara Tapo: en la app Tapo → la cámara → Configuración → Avanzado → Cuenta de la cámara.
# Es un usuario y clave propios de la cámara, distintos a los de tu cuenta Tapo.
CAMARA_IP=192.168.1.50
CAMARA_USUARIO=
CAMARA_CLAVE=

# Usuario «camara» de Supabase (se crea con CAMARA_CLAVE=... en bar-nube/supabase/crear_usuarios.sh).
BAR_CAMARA_USUARIO=camara
BAR_CAMARA_CLAVE=
