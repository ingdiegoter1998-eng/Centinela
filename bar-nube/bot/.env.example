# Copia este archivo a .env y llénalo EN EL CELULAR DEL BOT (nunca lo subas al repo).
SUPABASE_URL=https://xesmbhfgiosrhctjamru.supabase.co
# Llave service_role (Supabase → Project Settings → API). Es SECRETA: da acceso total a la base.
SUPABASE_SERVICE_KEY=
# Número de la SIM del bot, con indicativo y sin signos. Se usa para pedir el código de vinculación.
BOT_NUMBER=573108660167
# Segundos mínimos entre dos mensajes de un mismo cliente que el bot atiende (anti-spam)
LIMITE_MENSAJES_POR_MINUTO=12
# Cómo vincular la primera vez: qr (por defecto, se escanea) o codigo (código de 8 caracteres por número de teléfono)
LINK_MODE=qr
# Solo entre comillas (1 por defecto): el bot únicamente atiende mensajes escritos entre comillas, "así", y ignora el resto en silencio.
# Pon 0 para que atienda todo lo que le escriban.
SOLO_COMILLAS=1
# Atender también lo que tú escribes en el chat contigo mismo («Tú» / «Mensajéate»), con comillas. 1 por defecto; 0 para apagarlo.
# (PRUEBA_PROPIO=1 es el nombre antiguo y también lo enciende.)
ACEPTAR_PROPIO=1
