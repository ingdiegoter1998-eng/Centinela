# Copia este archivo a .env y llénalo EN EL CELULAR DEL BOT (nunca lo subas al repo).
SUPABASE_URL=https://xesmbhfgiosrhctjamru.supabase.co
# Llave service_role (Supabase → Project Settings → API). Es SECRETA: da acceso total a la base.
SUPABASE_SERVICE_KEY=
# Número de la SIM del bot, con indicativo y sin signos. Se usa para pedir el código de vinculación.
BOT_NUMBER=573170462345
# Segundos mínimos entre dos mensajes de un mismo cliente que el bot atiende (anti-spam)
LIMITE_MENSAJES_POR_MINUTO=12
